{
  "name": "incluaula-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "start:server": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "express": "^5.3.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
